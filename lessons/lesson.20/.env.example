# ============== Эмбеддинги ==============
# URL API эмбеддингов (например локальный сервер на порту 1234)
BASE_URL=http://localhost:1234/v1
# Имя модели эмбеддингов
EMBEDDING_MODEL=local
# Ключ API (если требуется)
API_KEY=lm-studio

# Размер батча при запросе эмбеддингов (меньше — стабильнее на слабом железе)
EMBEDDING_BATCH_SIZE=100

# ============== Чанкование документов ==============
# Максимальный размер чанка в символах (рекомендуется 300–700)
CHUNK_SIZE=500
# Перекрытие между соседними чанками в символах (рекомендуется 50–100)
CHUNK_OVERLAP=50

# ============== Qdrant ==============
# Хост и порт (по умолчанию при docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Имя коллекции векторов
QDRANT_COLLECTION=documents
# Сколько точек записывать за один запрос (при обрывах соединения уменьшить до 50)
QDRANT_UPSERT_BATCH_SIZE=100

# ============== Поиск (RAG) ==============
# Сколько ближайших чанков возвращать (top-k)
SEARCH_TOP_K=15
# Минимальный score релевантности; ниже — считаем «нет ответа» (для cosine обычно 0.4–0.7)
SCORE_THRESHOLD=0.5

# ============== Сборка ответа (GigaChat) ==============
# Ключ из личного кабинета GigaChat
GIGACHAT_CREDENTIALS=your_authorization_key_here
# Максимум токенов в ответе LLM
GIGACHAT_MAX_TOKENS=500
# Температура генерации (0–1, меньше — стабильнее)
GIGACHAT_TEMPERATURE=0.2

# ============== Telegram-бот ==============
TELEGRAM_BOT_TOKEN=your_bot_token_here
