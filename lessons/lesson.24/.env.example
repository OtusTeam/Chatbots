TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# GigaChat API (api.sberbank.ru) — учётные данные в формате base64 или путь к файлу
GIGACHAT_CREDENTIALS=your-gigachat-credentials
# GIGACHAT_MAX_TOKENS=500
# GIGACHAT_TEMPERATURE=0.2

# Webhook URL должен быть публичным. Для локальной машины используйте туннель (Ngrok/Cloudflared).
# Важно: WEBHOOK_URL должен включать WEBHOOK_PATH (например, .../webhook).
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ============================================
# Настройки базы данных
# ============================================

# Вариант 1: SQLite (для простых проектов)
# SQLite внутри контейнера будет храниться в volume, например: /data/db.sqlite
# Формат для SQLAlchemy обычно такой (4 слэша — абсолютный путь): sqlite:////data/db.sqlite
DATABASE_URL=sqlite:////data/db.sqlite

# Вариант 2: PostgreSQL (для продакшена, многопользовательских приложений)
# Раскомментируйте следующие строки и закомментируйте DATABASE_URL для SQLite выше
# POSTGRES_DB=telegram_bot
# POSTGRES_USER=bot_user
# POSTGRES_PASSWORD=bot_password
# DATABASE_URL=postgresql://bot_user:bot_password@postgres:5432/telegram_bot
# 
# Примечание: В Docker Compose имя сервиса (postgres) используется как hostname
# Для использования PostgreSQL запустите: docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
