# ============== Эмбеддинги ==============
# URL OpenAI‑совместимого API (например, локальный LM Studio на порту 1234)
BASE_URL=http://localhost:1234/v1
# Имя модели эмбеддингов
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# Ключ API (если требуется)
API_KEY=lm-studio

# Размер батча при запросе эмбеддингов (как в уроке 20)
EMBEDDING_BATCH_SIZE=100

# ============== Qdrant ==============
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ============== Fallback и качество ==============
# Порог score для правила «нет ответа» (для cosine обычно 0.4–0.7)
SCORE_THRESHOLD=0.5
# Таймаут RAG-цепочки (поиск + LLM), сек
RAG_TIMEOUT_SEC=30

# ============== GigaChat (LLM для ответов) ==============
GIGACHAT_CREDENTIALS=your_authorization_key_here

# ============== Telegram-бот (если используется) ==============
TELEGRAM_BOT_TOKEN=your_bot_token_here
