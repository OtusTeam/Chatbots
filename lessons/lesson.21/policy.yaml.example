# Конфигурация стратегии ответа (policy)
# Скопируйте в policy.yaml и при необходимости подстройте под свой бот.
# Часть параметров дублируется в .env (SCORE_THRESHOLD, RAG_TIMEOUT_SEC) для совместимости со скриптами.

# Порядок уровней fallback: сначала faq, затем rag, при неудаче — no_answer
fallback:
  order:
    - faq
    - rag
    - no_answer

# Пороги поиска (используются в search_qdrant при чтении из .env или при загрузке этого файла)
retrieval:
  score_threshold: 0.5   # минимальный score для «есть ответ» (cosine)
  top_k: 5
  # collection_name задаётся в .env как QDRANT_COLLECTION

# Таймауты и устойчивость
timeouts:
  rag_sec: 30           # таймаут вызова RAG (поиск + LLM)
  # retry при 429 задаётся в коде (answer_builder, embeddings)

# Формулировки ответов при отсутствии результата
messages:
  no_answer: "Не нашёл подходящего ответа в документах."
  error_fallback: "Извините, не могу ответить сейчас. Попробуйте позже."

# Опционально: расширение FAQ (ключ -> ответ); в коде можно загружать поверх встроенного FAQ
# faq:
#   "режим работы": "Пн–пт 9–18."
#   "контакты": "Телефон: 8-495-123-45-67."
